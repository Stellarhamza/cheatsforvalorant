---
import { pricingGallery } from '../data/valorant';
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import RelatedPages from './RelatedPages.astro';
import PlanSummaryPanels from './PlanSummaryPanels.astro';
import { contentSrc, contentSrcSet, productMainSizes, productThumbSizes } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
	showRelatedPages?: boolean;
	/** When true, renders product name as H1 (standalone product pages). */
	showPageTitle?: boolean;
}

const locale = Astro.props.locale ?? defaultLocale;
const showRelatedPages = Astro.props.showRelatedPages ?? true;
const showPageTitle = Astro.props.showPageTitle ?? false;
const ui = getUi(locale);

const monthlyPlan = productInfo.plans.find((plan) => plan.id === 'monthly') ?? productInfo.plans[0];
const lifetimePlan = productInfo.plans.find((plan) => plan.id === 'lifetime');
const defaultPlan = lifetimePlan ?? monthlyPlan;

const galleryImages = pricingGallery.map((image) => ({
	...image,
	displaySrc: contentSrc(image.src),
	displaySrcSet: contentSrcSet(image.src),
}));
const mainImage = galleryImages[0];
const thumbImages = galleryImages.slice(0, 6);

const featurePills = [
	{ icon: 'bolt', label: ui.trust.delivery },
	{ icon: 'shield', label: 'Undetected' },
	{ icon: 'headset', label: '24/7 support' },
] as const;
---

<section
	class="pricing-showcase surface-card"
	id="pricing"
	data-product
	aria-label={ui.nav.pricing}
>
	<div class="pricing-showcase__media">
		<figure class="pricing-showcase__figure media-frame">
			<img
				src={mainImage.displaySrc}
				srcset={mainImage.displaySrcSet}
				sizes={productMainSizes}
				alt={mainImage.alt}
				width="1280"
				height="720"
				class="pricing-showcase__image"
				data-main-image
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</figure>
		<div class="pricing-showcase__thumbs" role="group" aria-label="Valorant cheats screenshots">
			{
				thumbImages.map((image, index) => (
					<button
						type="button"
						class:list={['pricing-showcase__thumb', { 'is-active': index === 0 }]}
						aria-label={image.alt}
						aria-pressed={index === 0 ? 'true' : 'false'}
						data-thumb
						data-src={image.displaySrc}
						data-srcset={image.displaySrcSet ?? ''}
						data-alt={image.alt}
					>
						<img
							src={image.displaySrc}
							srcset={image.displaySrcSet}
							alt={image.alt}
							sizes={productThumbSizes}
							width="320"
							height="200"
							loading={index < 4 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					</button>
				))
			}
		</div>
	</div>

	<div
		class="pricing-showcase__checkout"
		data-plan-selector
		data-default-plan={defaultPlan.id}
		data-buy-prefix={ui.common.buyNow}
		data-buy-show-price="true"
	>
		{
			showPageTitle && (
				<h1 class="pricing-showcase__title">{productInfo.name}</h1>
			)
		}

		<div class="pricing-showcase__badges">
			<span class="pricing-showcase__badge">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M12 3l2.2 4.5 5 .7-3.6 3.5.9 5.1L12 14.8 7.5 16.8l.9-5.1L4.8 8.2l5-.7L12 3z"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linejoin="round"></path>
				</svg>
				{ui.product.gameBadge}
			</span>
			<span class="pricing-showcase__badge">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<rect x="3" y="5" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"></rect>
					<path d="M8 21h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
				</svg>
				Windows PC
			</span>
			<span class="pricing-showcase__badge pricing-showcase__badge--live">
				<span class="pricing-showcase__badge-dot" aria-hidden="true"></span>
				Undetected
			</span>
		</div>

		<div class="pricing-showcase__plans" role="group" aria-label="Select a license plan">
			<button
				type="button"
				class="pricing-showcase__plan"
				data-plan={monthlyPlan.id}
				data-plan-label={ui.product.monthly}
				data-plan-price={monthlyPlan.price}
				data-checkout-url={siteConfig.checkoutUrl}
				aria-pressed="false"
			>
				<span class="pricing-showcase__plan-label">{ui.product.monthly}</span>
				<span class="pricing-showcase__plan-price">${monthlyPlan.price}</span>
				<span class="pricing-showcase__plan-note">30 days access</span>
			</button>

			{
				lifetimePlan && (
					<button
						type="button"
						class="pricing-showcase__plan pricing-showcase__plan--featured is-selected"
						data-plan={lifetimePlan.id}
						data-plan-label={ui.product.lifetime}
						data-plan-price={lifetimePlan.price}
						data-checkout-url={siteConfig.checkoutUrl}
						aria-pressed="true"
					>
						<span class="pricing-showcase__plan-tag">Best value</span>
						<span class="pricing-showcase__plan-label">{ui.product.lifetime}</span>
						<span class="pricing-showcase__plan-price">${lifetimePlan.price}</span>
						<span class="pricing-showcase__plan-note">One-time payment</span>
					</button>
				)
			}
		</div>

		<PlanSummaryPanels defaultPlanId={defaultPlan.id} class="pricing-showcase__summary" />

		<a
			href={siteConfig.checkoutUrl}
			class="pricing-showcase__cart button-standard button-standard--fill"
			data-plan-buy
			rel="noopener noreferrer"
		>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M13 3L4 14h6l-1 7 9-11h-6l1-7z"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
			<span data-plan-buy-label>{ui.common.buyNow} — ${defaultPlan.price}</span>
		</a>

		<div class="pricing-showcase__trust" aria-label="Package highlights">
			{
				featurePills.map((pill) => (
					<span class="pricing-showcase__trust-item">
						<span class="pricing-showcase__trust-icon" aria-hidden="true">
							{pill.icon === 'bolt' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<path d="M13 3 5.5 13.5H12l-1 7.5L19.5 10H13l0-7Z" stroke-linejoin="round"></path>
								</svg>
							)}
							{pill.icon === 'shield' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<path d="M12 3.5 5 6.5v5.2c0 4.2 2.9 7.8 7 8.8 4.1-1 7-4.6 7-8.8V6.5L12 3.5Z" stroke-linejoin="round"></path>
								</svg>
							)}
							{pill.icon === 'headset' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<path d="M4 14v-2a8 8 0 0 1 16 0v2M4 14a2 2 0 0 0 2 2h1v-5H6a2 2 0 0 0-2 2Zm16 0a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Z" stroke-linecap="round"></path>
								</svg>
							)}
						</span>
						{pill.label}
					</span>
				))
			}
		</div>

		{showRelatedPages && <RelatedPages locale={locale} />}
	</div>
</section>

<script>
	import { initPlanSelectors } from '../lib/plan-selector';
	initPlanSelectors();

	document.querySelectorAll('[data-product]').forEach((root) => {
		const imageThumbs = root.querySelectorAll('[data-thumb]');
		const mainImage = root.querySelector('[data-main-image]');

		imageThumbs.forEach((thumb) => {
			thumb.addEventListener('click', () => {
				if (!(mainImage instanceof HTMLImageElement)) return;
				const src = thumb.getAttribute('data-src');
				const srcset = thumb.getAttribute('data-srcset');
				const alt = thumb.getAttribute('data-alt');
				if (src) mainImage.src = src;
				if (srcset) mainImage.srcset = srcset;
				else mainImage.removeAttribute('srcset');
				if (alt) mainImage.alt = alt;
				imageThumbs.forEach((item) => {
					const active = item === thumb;
					item.classList.toggle('is-active', active);
					item.setAttribute('aria-pressed', active ? 'true' : 'false');
				});
			});
		});
	});
</script>

<style>
	.pricing-showcase {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(2rem, 4vw, 3rem);
		align-items: start;
		width: 100%;
		margin: 0;
		padding: clamp(1.75rem, 3vw, 2.75rem);
		border-radius: var(--radius-card);
	}

	.pricing-showcase__media {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		min-width: 0;
	}

	.pricing-showcase__figure {
		margin: 0;
		aspect-ratio: 16 / 10;
		border: 1px solid rgba(255, 70, 85, 0.28);
		border-radius: var(--radius-media);
		overflow: hidden;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
	}

	.pricing-showcase__figure.media-frame img,
	.pricing-showcase__thumb img {
		transform: none;
	}

	.pricing-showcase__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transform: none;
		transition: opacity 0.14s ease;
	}

	.pricing-showcase__thumbs {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.pricing-showcase__thumb {
		position: relative;
		padding: 0;
		aspect-ratio: 16 / 10;
		width: 100%;
		border: 2px solid transparent;
		border-radius: 0.65rem;
		background: var(--color-surface);
		cursor: pointer;
		overflow: hidden;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.pricing-showcase__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.pricing-showcase__thumb.is-active,
	.pricing-showcase__thumb:hover {
		border-color: var(--color-orchid);
		transform: translateY(-1px);
	}

	.pricing-showcase__checkout {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		min-width: 0;
	}

	.pricing-showcase__title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.pricing-showcase__badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.pricing-showcase__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.75rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 70, 85, 0.22);
		background: var(--color-card);
		color: var(--color-orchid);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.pricing-showcase__badge--live {
		color: var(--color-mint);
		border-color: rgba(255, 70, 85, 0.3);
	}

	.pricing-showcase__badge-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--color-mint);
	}

	.pricing-showcase__plans {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		align-items: stretch;
	}

	.pricing-showcase__plan {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.15rem;
		width: 100%;
		min-height: 5.5rem;
		margin: 0;
		padding: 1rem 1.05rem;
		border-radius: 0.9rem;
		border: 1px solid rgba(255, 70, 85, 0.22);
		background: var(--color-card);
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	.pricing-showcase__plan:hover {
		border-color: rgba(255, 70, 85, 0.45);
	}

	.pricing-showcase__plan.is-selected {
		border-color: rgba(255, 70, 85, 0.55);
		box-shadow: inset 0 0 0 1px rgba(255, 70, 85, 0.35);
		background: var(--color-card-hover);
	}

	.pricing-showcase__plan--featured {
		border-color: rgba(255, 70, 85, 0.45);
		background: linear-gradient(165deg, rgba(255, 70, 85, 0.14) 0%, rgba(10, 14, 18, 0.98) 100%);
	}

	.pricing-showcase__plan--featured.is-selected {
		border-color: rgba(255, 107, 119, 0.65);
		box-shadow:
			inset 0 0 0 1px rgba(255, 107, 119, 0.35),
			0 8px 24px rgba(255, 70, 85, 0.12);
	}

	.pricing-showcase__plan-tag {
		position: absolute;
		top: 0.55rem;
		right: 0.65rem;
		padding: 0.18rem 0.5rem;
		border-radius: 999px;
		background: rgba(255, 70, 85, 0.2);
		border: 1px solid rgba(255, 70, 85, 0.35);
		color: #ff8a94;
		font-size: 0.58rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.pricing-showcase__plan-label {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.pricing-showcase__plan--featured .pricing-showcase__plan-label {
		color: rgba(236, 232, 225, 0.82);
	}

	.pricing-showcase__plan-price {
		font-family: var(--font-sans);
		font-size: clamp(1.65rem, 3vw, 2rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.05;
		color: var(--color-ink);
	}

	.pricing-showcase__plan-note {
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--color-faint);
	}

	.pricing-showcase__summary :global(.plan-summary__panel) {
		padding: 0.85rem 1rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(255, 70, 85, 0.18);
		background: var(--color-card);
	}

	.pricing-showcase__summary :global(.plan-summary__panel ul) {
		grid-template-columns: 1fr;
		gap: 0.25rem;
		padding-left: 1rem;
		list-style: none;
	}

	.pricing-showcase__summary :global(.plan-summary__panel li) {
		position: relative;
		padding-left: 0.85rem;
		font-size: 0.84rem;
	}

	.pricing-showcase__summary :global(.plan-summary__panel li::before) {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--color-orchid);
	}

	.pricing-showcase__cart {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		width: 100%;
		margin: 0;
		padding: 0.95rem 1.15rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 800;
		text-transform: none;
	}

	.pricing-showcase__trust {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1rem;
		padding-top: 0.15rem;
	}

	.pricing-showcase__trust-item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--color-muted);
		font-size: 0.78rem;
		font-weight: 600;
	}

	.pricing-showcase__trust-icon {
		display: grid;
		place-items: center;
		width: 1.15rem;
		height: 1.15rem;
		color: var(--color-orchid);
	}

	.pricing-showcase__trust-icon svg {
		width: 100%;
		height: 100%;
	}

	@media (max-width: 1100px) {
		.pricing-showcase__thumbs {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}
	}

	@media (max-width: 900px) {
		.pricing-showcase {
			grid-template-columns: 1fr;
		}

		.pricing-showcase__plans {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.pricing-showcase__plans {
			grid-template-columns: 1fr;
		}

		.pricing-showcase__thumbs {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
