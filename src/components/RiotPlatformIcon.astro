---
type Platform =
	| 'windows'
	| 'apple'
	| 'mobile'
	| 'playstation'
	| 'xbox'
	| 'nintendo'
	| 'tradingCard';

interface Props {
	platform: Platform;
}

const { platform } = Astro.props;

const labels: Record<Platform, string> = {
	windows: 'windows',
	apple: 'apple',
	mobile: 'mobile',
	playstation: 'playstation',
	xbox: 'xbox',
	nintendo: 'nintendo',
	tradingCard: 'trading card',
};
---

<span class="icon icon--platform" class:list={[`icon--${platform}`]}>
	<span class="is-vhidden">{labels[platform]}</span>
	{
		platform === 'windows' && (
			<svg width="18" height="17" viewBox="0 0 18 17" fill="none" aria-hidden="true">
				<path
					d="M.445 2.405l6.947-.943.003 6.681-6.941.037-.009-5.774zM7.39 8.913l.005 6.684-6.941-.95v-5.78l6.934.046h.002zm.843-7.573L17.44 0v8.058l-9.208.073V1.34h.002zm9.212 7.634L17.437 17 8.23 15.705l-.014-6.743 9.224.014.005-.002z"
					fill="#FCFCFC"></path>
