---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PricingFeatureList from '../components/PricingFeatureList.astro';
import Gallery from '../components/Gallery.astro';
import HomeFaq from '../components/HomeFaq.astro';
import HomeSeo from '../components/HomeSeo.astro';
import HomeWhatsHappening from '../components/HomeWhatsHappening.astro';
import HomeGamesShowcase from '../components/HomeGamesShowcase.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getCanonicalPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { homeFaqs, productInfo, siteConfig, customerReviewStats, customerReviews } from '../data/site';
import { valorantImages } from '../data/valorant';
import {
	buildAggregateOffer,
	buildFaqSchemaNode,
	buildSoftwareApplicationSchema,
} from '../data/schema';
import { heroPreloadSrc, heroSizes, heroSrcSet, heroIsExternal } from '../lib/responsive-images';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');

const title = home.title;
const description = home.description;
const canonicalPath = getCanonicalPath('home', locale);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
const heroImage = new URL(valorantImages.hero, siteConfig.url).href;

const storeNote =
	locale === 'de'
		? 'CheatsForValorant — Unentdecktes ESP & Aimbot für PC: Wallhack, Soft Aim, Triggerbot und Radar in einer Lizenz.'
		: 'ESP wallhack, aimbot, triggerbot, and radar — one undetected Valorant cheat license for Windows PC.';

const localeSummary = locale === 'de' ? home.intro : productInfo.summary;

const extraGraph: Record<string, unknown>[] = [
	{
		'@type': 'Product',
		'@id': `${canonicalURL}#product`,
		name: productInfo.name,
		description: productInfo.summary,
		image: heroImage,
		brand: { '@type': 'Brand', name: productInfo.brand },
		category: 'Valorant cheats',
		url: canonicalURL,
		offers: buildAggregateOffer(canonicalURL),
		aggregateRating: {
			'@type': 'AggregateRating',
			ratingValue: customerReviewStats.averageRating.toFixed(1),
			reviewCount: customerReviewStats.totalCount,
			bestRating: '5',
			worstRating: '1',
		},
		review: customerReviews.map((review) => ({
			'@type': 'Review',
			author: { '@type': 'Person', name: review.handle },
			datePublished: review.date,
			reviewRating: {
				'@type': 'Rating',
				ratingValue: String(review.rating),
				bestRating: '5',
				worstRating: '1',
			},
			reviewBody: review.text,
		})),
	},
	buildSoftwareApplicationSchema(canonicalURL, heroImage),
	buildFaqSchemaNode(canonicalURL, homeFaqs),
	{
		'@type': 'VideoObject',
		'@id': `${canonicalURL}#hero-video`,
		name: `${siteConfig.name} — undetected Valorant cheats`,
		description: productInfo.summary,
		thumbnailUrl: new URL(valorantImages.heroPoster, siteConfig.url).href,
		contentUrl: new URL(valorantImages.heroVideo, siteConfig.url).href,
		uploadDate: '2026-08-03',
		inLanguage: locale,
	},
];
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={home.imageAlt}
	locale={locale}
	pageId="home"
	breadcrumbs={[{ label: ui.nav.home }]}
	extraGraph={extraGraph}
	lcpImage={heroPreloadSrc}
	lcpImageSrcSet={heroIsExternal ? undefined : heroSrcSet}
	lcpImageSizes={heroSizes}
>
	<Navbar locale={locale} pageId="home" overlay />
	<main class="site">
		<Hero
			locale={locale}
			imageAlt={home.imageAlt}
			accent={ui.hero.accent}
			subtitle={ui.hero.subtitle}
			subtitleShort={ui.hero.subtitleShort}
		/>
		<section
			class="site__section site__section--intro riot-section widget--spacing-padding-large"
			aria-labelledby="home-intro-title"
		>
			<div class="content-center content-gutter--large home-intro">
				<p class="home-intro__trust">{ui.trust.statusNote}</p>
				<h2 id="home-intro-title" class="riot-heading">{home.sections[0]?.h2 ?? ui.product.title}</h2>
				<p class="home-intro__lead">{home.intro}</p>
				{
					home.sections[0]?.paragraphs.map((paragraph) => (
						<p class="home-intro__copy" set:html={paragraph} />
					))
				}
				{
					home.sections.slice(1).map((section) => (
						<div class="home-intro__block">
							<p class="home-intro__block-title">{section.h2}</p>
							{section.paragraphs.map((paragraph) => (
								<p class="home-intro__copy" set:html={paragraph} />
							))}
						</div>
					))
				}
			</div>
		</section>
		<HomeWhatsHappening locale={locale} />
		<HomeGamesShowcase locale={locale} />
		<section
			class="site__section site__section--store riot-section widget--spacing-padding-large"
			id="store"
			aria-label={ui.product.title}
		>
			<div class="content-center content-gutter--large section-stack store-stack">
				<header class="section-head store-intro">
					<p class="store-intro__eyebrow">{ui.product.title}</p>
					<p class="section-head__copy store-intro__copy">{localeSummary}</p>
					<p class="section-head__note store-intro__note">{storeNote}</p>
				</header>
				<PricingFeatureList locale={locale} showRelatedPages={false} />
			</div>
		</section>
		<section class="site__section site__section--reviews riot-section widget--spacing-padding-large">
			<div class="content-center content-gutter--large">
				<CustomerReviews locale={locale} />
			</div>
		</section>
		<section class="site__section site__section--faq riot-section widget--spacing-padding-large">
			<div class="content-center content-gutter--large">
				<HomeFaq locale={locale} />
			</div>
		</section>
		{locale === defaultLocale && <HomeSeo />}
		<section class="site__section site__section--gallery riot-section widget--spacing-padding-large is-seo-only">
			<div class="content-center content-gutter--large">
				<Gallery locale={locale} />
			</div>
		</section>
	</main>
	<SiteFooter locale={locale} pageTitle={title} />
</Layout>

<style>
	.site {
		overflow-x: clip;
	}

	.home-intro {
		display: grid;
		gap: 1rem;
		max-width: 46rem;
		padding-block: clamp(1.5rem, 3vw, 2.25rem);
	}

	.home-intro__trust {
		margin: 0;
		color: var(--color-orchid);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.home-intro__lead,
	.home-intro__copy {
		margin: 0;
		color: rgba(236, 232, 225, 0.78);
		font-size: 1rem;
		line-height: 1.65;
	}

	.home-intro__block {
		display: grid;
		gap: 0.65rem;
		padding-top: 0.75rem;
		border-top: 1px solid rgba(236, 232, 225, 0.08);
	}

	.home-intro__block-title {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #ece8e1;
	}

	.store-intro__eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.site__section--reviews,
	.site__section--store,
	.site__section--gallery {
		content-visibility: auto;
		contain-intrinsic-size: 1px 720px;
		padding-block: 0;
	}

	.site__section--faq {
		padding-block: clamp(2.5rem, 5vw, 3.5rem);
	}

	.site__section--gallery.is-seo-only {
		padding-block: 0;
		margin: 0;
		contain-intrinsic-size: 1px 1px;
	}

	.store-intro__copy {
		color: rgba(236, 232, 225, 0.78);
	}

	.store-intro__note {
		margin: 0;
	}

	.store-stack {
		gap: var(--section-stack-gap);
	}

	@media (max-width: 760px) {
		.site__section--store {
			contain-intrinsic-size: 1px 900px;
		}
	}
</style>
