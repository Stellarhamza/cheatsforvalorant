---
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getHomeExploreLinks } from '../lib/internal-links';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const links = getHomeExploreLinks(locale);
---

<section class="home-explore" aria-labelledby="home-explore-title">
	<header class="section-head home-explore__head">
		<h2 id="home-explore-title" class="riot-heading">Explore more</h2>
		<p class="section-head__copy home-explore__intro">
			Guides, feature pages, setup help, reviews, and blog posts — compare everything before you buy.
		</p>
	</header>

	<div class="home-explore__grid">
		{
			links.map((link) => (
				<a href={link.href} class="home-explore__card">
					<span class="home-explore__card-label">{link.label}</span>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M5 12h14m-6-6l6 6-6 6"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</a>
			))
		}
	</div>
</section>

<style>
	.home-explore {
		display: grid;
		gap: clamp(1.75rem, 3vw, 2.5rem);
		padding-block: 0;
	}

	.home-explore__head {
		margin-bottom: 0;
	}

	.home-explore__intro {
		margin: 0;
	}

	.home-explore__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.home-explore__card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem;
		min-height: 3.25rem;
		padding: 0.95rem 1.1rem;
		border: 1px solid rgba(255, 70, 85, 0.14);
		border-radius: 0.75rem;
		background: var(--color-surface);
		color: #ece8e1;
		font-size: 0.88rem;
		font-weight: 650;
		line-height: 1.35;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			transform 0.2s ease;
	}

	.home-explore__card:hover,
	.home-explore__card:focus-visible {
		border-color: rgba(255, 70, 85, 0.38);
		background: var(--color-surface-raised);
		transform: translateY(-1px);
		color: #ece8e1;
	}

	.home-explore__card svg {
		flex-shrink: 0;
		color: var(--color-orchid);
	}

	.home-explore__card-label {
		min-width: 0;
	}

	@media (max-width: 1100px) {
		.home-explore__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 680px) {
		.home-explore__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
