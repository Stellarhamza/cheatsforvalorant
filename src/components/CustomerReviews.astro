---
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { customerReviewStats, customerReviews } from '../data/site';
import { getReviewPath, reviewsBasePath } from '../data/reviews';
import ReviewAvatar from './ReviewAvatar.astro';
import StarRating from './StarRating.astro';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const reviewsUi = ui.reviews;
const featuredReviews = customerReviews.slice(0, 4);

const reviewDateFormatter = new Intl.DateTimeFormat(locale, {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
});

function formatReviewDate(isoDate: string): string {
	return reviewDateFormatter.format(new Date(`${isoDate}T00:00:00Z`));
}

const seeAllLabel = reviewsUi.seeAll ?? 'See all reviews';
const verifiedLabel = reviewsUi.verifiedLabel ?? 'Verified customer';
---

<section class="reviews" aria-labelledby="reviews-title">
	<header class="section-head reviews__head">
		<div class="reviews__intro">
			<h2 id="reviews-title" class="riot-heading">{reviewsUi.title}</h2>
			<p class="section-head__copy reviews__summary">
				<span class="reviews__score">{customerReviewStats.averageRating.toFixed(1)}</span>
				<StarRating rating={customerReviewStats.averageRating} size="sm" />
				<span class="reviews__summary-copy">
					{customerReviewStats.totalCount} verified {reviewsUi.countLabel}
				</span>
			</p>
		</div>
		<a class="reviews__see-all" href={reviewsBasePath}>{seeAllLabel}</a>
	</header>

	<div class="reviews__grid">
		{
			featuredReviews.map((review) => (
				<article class="reviews__card">
					<div class="reviews__card-top">
						<div class="reviews__who">
							<ReviewAvatar handle={review.handle} size={40} />
							<div class="reviews__meta">
								<p class="reviews__handle">@{review.handle}</p>
								<p class="reviews__verified">{verifiedLabel}</p>
							</div>
						</div>
						<div class="reviews__rating-block">
							<StarRating rating={review.rating} size="sm" />
							<p class="reviews__date">
								<time datetime={review.date}>{formatReviewDate(review.date)}</time>
							</p>
						</div>
					</div>
					<p class="reviews__title">{review.title}</p>
					<p class="reviews__text">{review.short}</p>
					<a class="reviews__read" href={getReviewPath(review.slug)}>Read @{review.handle} review</a>
				</article>
			))
		}
	</div>
</section>

<style>
	.reviews {
		padding-block: 0;
	}

	.reviews__head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem 2rem;
		margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
	}

	.reviews__intro {
		display: grid;
		gap: 0.65rem;
		max-width: 40rem;
	}

	.reviews__summary {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem 0.75rem;
		margin: 0;
	}

	.reviews__score {
		color: var(--color-ink);
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.reviews__summary-copy {
		color: rgba(236, 232, 225, 0.62);
		font-size: 0.9rem;
		font-weight: 500;
		line-height: 1.4;
	}

	.reviews__see-all {
		color: var(--color-orchid);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}

	.reviews__see-all:hover {
		color: var(--color-ink);
	}

	.reviews__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
		border-top: 1px solid rgba(236, 232, 225, 0.08);
	}

	.reviews__card {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		padding: 1.35rem 0;
		border: 0;
		border-bottom: 1px solid rgba(236, 232, 225, 0.08);
		background: transparent;
		color: inherit;
	}

	.reviews__card:nth-child(odd) {
		padding-right: 1.25rem;
	}

	.reviews__card:nth-child(even) {
		padding-left: 1.25rem;
		border-left: 1px solid rgba(236, 232, 225, 0.08);
	}

	.reviews__card-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.reviews__who {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		min-width: 0;
	}

	.reviews__meta {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
	}

	.reviews__handle {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--color-ink);
		overflow-wrap: anywhere;
	}

	.reviews__verified {
		margin: 0;
		color: rgba(236, 232, 225, 0.5);
		font-size: 0.72rem;
		font-weight: 500;
		line-height: 1.3;
	}

	.reviews__rating-block {
		display: grid;
		justify-items: end;
		gap: 0.3rem;
		flex-shrink: 0;
	}

	.reviews__date {
		margin: 0;
		font-size: 0.72rem;
		color: rgba(236, 232, 225, 0.45);
		white-space: nowrap;
	}

	.reviews__title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: -0.02em;
		color: #ece8e1;
	}

	.reviews__text {
		margin: 0;
		color: rgba(236, 232, 225, 0.72);
		font-size: 0.88rem;
		line-height: 1.6;
		flex-grow: 1;
	}

	.reviews__read {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		margin-top: 0.15rem;
		color: var(--color-orchid);
		font-size: 0.84rem;
		font-weight: 650;
		text-decoration: none;
	}

	.reviews__read:hover {
		color: var(--color-ink);
	}

	@media (max-width: 680px) {
		.reviews__grid {
			grid-template-columns: 1fr;
		}

		.reviews__card:nth-child(odd),
		.reviews__card:nth-child(even) {
			padding-left: 0;
			padding-right: 0;
			border-left: 0;
		}

		.reviews__head {
			flex-direction: column;
			align-items: flex-start;
		}

		.reviews__card-top {
			flex-direction: column;
			gap: 0.65rem;
		}

		.reviews__rating-block {
			justify-items: start;
		}
	}
</style>
