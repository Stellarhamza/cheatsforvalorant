---
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { customerReviewStats, customerReviews } from '../data/site';
import { getReviewPath, reviewsBasePath } from '../data/reviews';
import ReviewAvatar from './ReviewAvatar.astro';
import StarRating from './StarRating.astro';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const reviewsUi = ui.reviews;
const trustUi = ui.trust;
const featuredReviews = customerReviews.slice(0, 4);

const reviewDateFormatter = new Intl.DateTimeFormat(locale, {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
});

function formatReviewDate(isoDate: string): string {
	return reviewDateFormatter.format(new Date(`${isoDate}T00:00:00Z`));
}

const seeAllLabel = reviewsUi.seeAll ?? 'See all reviews';
const verifiedLabel = reviewsUi.verifiedLabel ?? 'Verified customer';
---

<section class="reviews" aria-labelledby="reviews-title">
	<header class="reviews__header">
		<div class="reviews__intro">
			<h2 id="reviews-title" class="riot-heading">{reviewsUi.title}</h2>
			<div class="reviews__summary">
				<StarRating rating={customerReviewStats.averageRating} size="md" showValue />
				<p class="reviews__summary-copy">
					{customerReviewStats.totalCount} verified {reviewsUi.countLabel}
				</p>
			</div>
		</div>
		<a class="reviews__see-all button-standard button-standard--black button-standard--small" href={reviewsBasePath}>
			{seeAllLabel}
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M5 12h14m-6-6l6 6-6 6"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</header>

	<div class="reviews__grid">
		{
			featuredReviews.map((review) => (
				<article class="reviews__card">
					<div class="reviews__card-top">
						<div class="reviews__who">
							<ReviewAvatar handle={review.handle} size={46} />
							<div class="reviews__meta">
								<p class="reviews__handle">@{review.handle}</p>
								<p class="reviews__verified">
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path
											d="M20 7 10 17l-5-5"
											stroke="currentColor"
											stroke-width="2.2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									{verifiedLabel}
								</p>
							</div>
						</div>
						<div class="reviews__rating-block">
							<StarRating rating={review.rating} size="sm" />
							<p class="reviews__date">
								<time datetime={review.date}>{formatReviewDate(review.date)}</time>
							</p>
						</div>
					</div>
					<h3 class="reviews__title">{review.title}</h3>
					<p class="reviews__text">{review.short}</p>
					<p class="reviews__read">
						<a href={getReviewPath(review.slug)}>
							Read full review
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path
									d="M5 12h14m-6-6l6 6-6 6"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</a>
					</p>
				</article>
			))
		}
	</div>

	<div class="reviews__foot" aria-label="Purchase highlights">
		<span class="reviews__chip">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M13 2 4 14h7l-1 8 10-14H13l1-6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
			</svg>
			{trustUi.delivery}
		</span>
		<span class="reviews__chip">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<rect x="3" y="5" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6" />
				<path d="M8 21h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
			</svg>
			{trustUi.platform}
		</span>
		<span class="reviews__chip">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M12 3 4 7v6c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V7l-8-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
			</svg>
			{trustUi.antiCheatShort}
		</span>
	</div>
</section>

<style>
	.reviews {
		padding-block: 0;
	}

	.reviews__header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.reviews__intro {
		display: grid;
		gap: 0.75rem;
		max-width: 44rem;
	}

	.reviews__summary {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
	}

	.reviews__summary-copy {
		margin: 0;
		color: rgba(236, 232, 225, 0.68);
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.45;
	}

	.reviews__see-all {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		white-space: nowrap;
	}

	.reviews__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.reviews__card {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1.25rem 1.3rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(255, 70, 85, 0.14);
		background: var(--color-surface);
		color: inherit;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			background 0.2s ease;
	}

	.reviews__card:hover {
		border-color: rgba(255, 70, 85, 0.38);
		background: var(--color-surface-raised);
		transform: translateY(-2px);
	}

	.reviews__card-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.reviews__who {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}

	.reviews__meta {
		display: grid;
		gap: 0.25rem;
		min-width: 0;
	}

	.reviews__handle {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--color-ink);
		overflow-wrap: anywhere;
	}

	.reviews__verified {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin: 0;
		color: var(--color-bright);
		font-size: 0.68rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.reviews__rating-block {
		display: grid;
		justify-items: end;
		gap: 0.35rem;
		flex-shrink: 0;
	}

	.reviews__date {
		margin: 0;
		font-size: 0.72rem;
		color: var(--color-faint);
		white-space: nowrap;
	}

	.reviews__title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.98rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: -0.02em;
		color: #ece8e1;
	}

	.reviews__text {
		margin: 0;
		color: rgba(236, 232, 225, 0.78);
		font-size: 0.88rem;
		line-height: 1.65;
		flex-grow: 1;
	}

	.reviews__read {
		margin: 0;
	}

	.reviews__read a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-orchid);
		font-size: 0.84rem;
		font-weight: 700;
		text-decoration: none;
	}

	.reviews__read a:hover {
		color: var(--color-bright);
	}

	.reviews__foot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1.25rem;
	}

	.reviews__chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 0.85rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 70, 85, 0.22);
		background: rgba(255, 70, 85, 0.08);
		color: rgba(236, 232, 225, 0.82);
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.35;
	}

	.reviews__chip svg {
		flex-shrink: 0;
		color: var(--color-bright);
	}

	@media (max-width: 680px) {
		.reviews__grid {
			grid-template-columns: 1fr;
		}

		.reviews__see-all {
			width: 100%;
			justify-content: center;
			min-height: var(--touch-min);
		}

		.reviews__header {
			flex-direction: column;
		}

		.reviews__card-top {
			flex-direction: column;
			gap: 0.75rem;
		}

		.reviews__rating-block {
			justify-items: start;
		}
	}
</style>
